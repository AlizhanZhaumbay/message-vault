                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"Body wiped from database\", () => {",
                  "    pm.expect(json.status).to.eql(\"destroyed\");",
                  "    pm.expect(json.body).to.eql(null);",
                  "});"
                ]
              }
            }
          ]
        }
