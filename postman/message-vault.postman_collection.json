        {
          "name": "Read burn-after-reading (last view)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/messages/{{message_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"Last reader still gets the content\", () => pm.expect(json.body).to.include(\"oak\"));",
                  "pm.test(\"Message is now destroyed\", () => {",
                  "    pm.expect(json.status).to.eql(\"destroyed\");",
                  "    pm.expect(json.remaining_views).to.eql(0);",
                  "    pm.expect(json.destroyed_reason).to.eql(\"read_once\");",
                  "});",
                  "pm.test(\"Signed download links\", () => {",
                  "    pm.expect(json.attachments).to.have.lengthOf(3);",
                  "    json.attachments.forEach(a => pm.expect(a.download_url).to.include(\"signature=\"));",
                  "});",
                  "const png = json.attachments.find(a => a.mime_type === \"image/png\");",
                  "pm.collectionVariables.set(\"download_url\", png.download_url);",
                  "pm.collectionVariables.set(\"tampered_download_url\", png.download_url + \"tampered\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Download attachment (signed URL)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{download_url}}"
