                  "pm.test(\"Status is 410\", () => pm.response.to.have.status(410));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"Tombstone without content\", () => {",
                  "    pm.expect(json.tombstone).to.include.all.keys(\"title\", \"created_at\", \"first_viewed_at\", \"destroyed_at\", \"destroyed_reason\");",
                  "    pm.expect(json.tombstone.destroyed_reason).to.eql(\"read_once\");",
                  "    pm.expect(json).to.not.have.property(\"body\");",
                  "});"
                ]
