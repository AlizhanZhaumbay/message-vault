{
  "info": {
    "_postman_id": "3a47d144-b175-54a1-8bb6-01fb472015ce",
    "name": "Message Vault",
    "description": "Run top to bottom in the Collection Runner. Set Settings → General → Working directory to the repository's postman/ folder so samples/* files resolve.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: \"Accept\", value: \"application/json\" });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Overview",
      "item": [
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/stats"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"Has counters\", () => {",
                  "    pm.expect(json.messages).to.have.all.keys(\"sealed\", \"available\", \"destroyed\");",
                  "    pm.expect(json.files).to.have.all.keys(\"count\", \"total_size_bytes\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List messages",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/messages"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"Paginated list\", () => {",
                  "    pm.expect(json.data).to.be.an(\"array\");",
                  "    pm.expect(json.meta).to.have.property(\"total\");",
                  "});",
                  "pm.test(\"Never exposes body or files\", () => {",
                  "    json.data.forEach(m => {",
                  "        pm.expect(m).to.not.have.property(\"body\");",
                  "        pm.expect(m.attachments).to.have.all.keys(\"count\", \"types\");",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List sealed only",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/messages?status=sealed"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"Every item is sealed\", () => {",
                  "    pm.response.json().data.forEach(m => {",
                  "        pm.expect(m.status).to.eql(\"sealed\");",
                  "        pm.expect(m.seconds_until_unlock).to.be.above(0);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List with unknown status → 422",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/messages?status=lost"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));",
                  "",
                  "pm.test(\"Error points to status\", () => pm.expect(pm.response.json().errors).to.have.property(\"status\"));"
                ]
              }
            }
          ]
        }
      ]
    },
