# Copy to .env before the first start: cp .env.example .env
# docker-compose.yml reads these values and passes them to the containers.

# --- Application -------------------------------------------------------------
APP_NAME="Message Vault"
# production | local; local turns on Eloquent lazy-loading checks.
APP_ENV=production
# Signs download links. Generate: docker compose run --rm --no-deps --entrypoint php app artisan key:generate --show
# Left empty, each container start generates a temporary key (old links stop working).
APP_KEY=
# true adds stack traces to JSON errors; keep false for the demo.
APP_DEBUG=false
APP_URL=http://localhost:8000
# Host port published for the API (the only API port reachable from outside).
APP_PORT=8000
# debug | info | warning | error; logs go to stderr (docker compose logs).
LOG_LEVEL=info

# --- PostgreSQL (internal only, no published port) ---------------------------
DB_DATABASE=message_vault
DB_USERNAME=vault
DB_PASSWORD=vault-secret

# --- Attachments ---------------------------------------------------------------
# Max files per message.
VAULT_MAX_FILES=5
# Max size of one file in MB; also becomes PHP upload_max_filesize.
VAULT_MAX_FILE_SIZE_MB=20
# PHP post_max_size: the whole request; keep >= VAULT_MAX_FILES * VAULT_MAX_FILE_SIZE_MB + some room.
PHP_POST_MAX_SIZE=110M
# Comma-separated whitelist of MIME types detected from file content.
VAULT_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/quicktime,audio/mpeg,audio/ogg,audio/wav,audio/x-wav,application/pdf,text/plain
# Lifetime of signed download links; destroyed messages keep files this long (+1 min).
VAULT_DOWNLOAD_LINK_TTL_MINUTES=5

# --- API -----------------------------------------------------------------------
# Page size of GET /api/messages.
VAULT_PER_PAGE=15
